{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Anywhere",
  "version": "0.10.4",
  "identifier": "com.arya.claude-anywhere",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../server.mjs": "server/server.mjs",
      "../package.json": "server/package.json",
      "../lib": "server/lib",
      "../public": "server/public",
      "../node_modules": "server/node_modules",
      "../runtime": "server/runtime"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
