{
  "name": "claude-anywhere",
  "version": "0.9.5",
  "description": "Your computer's Claude Code sessions, from any device, with any of your Claude accounts - self-hosted, no relay in the middle.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent-sdk",
    "self-hosted",
    "tauri",
    "remote"
  ],
  "homepage": "https://github.com/aryasadeghy/claude-anywhere#readme",
  "bugs": "https://github.com/aryasadeghy/claude-anywhere/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasadeghy/claude-anywhere.git"
  },
  "license": "MIT",
  "author": "Arya Sadeghi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "cargo tauri dev",
    "dist": "node scripts/fetch-node.mjs && cargo tauri build",
    "fetch-node": "node scripts/fetch-node.mjs",
    "release": "node scripts/release.mjs",
    "check": "node --check server.mjs && node --check lib/runs.mjs && node --check lib/tail.mjs && node --check lib/auth.mjs && node --check public/app.js",
    "mobile": "node scripts/mobile.mjs",
    "tauri": "npx -y @tauri-apps/cli@^2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "marked": "^18.0.13",
    "zod": "^4.6.5"
  }
}
