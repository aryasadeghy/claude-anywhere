# Optional app password. Leave empty and the app needs no password at all: anyone who can
# reach the port can then use Claude on this PC, so keep it on localhost, Tailscale, or a
# network you trust. Set one to require it on every device - here, or from the app
# (Settings → Remote access), which also lists the signed-in devices. One set here wins.
REMOTE_PASSWORD=
# Where to listen. 127.0.0.1 = this PC only; 0.0.0.0 = reachable from the phone (LAN / Tailscale).
HOST=127.0.0.1
PORT=7777
# Your name, for the greeting
USER_NAME=you
# Once an hour the server asks GitHub whether a newer release exists, and the app says so.
# Nothing is sent: it is a read of the public Releases page. Set to off to never ask.
# CLAUDE_ANYWHERE_UPDATE_CHECK=off

# The Claude account is chosen inside the app (this computer's login, or a pasted token),
# not here. These are only for running the server on a fixed account from the shell:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
